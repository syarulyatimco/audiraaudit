APP_NAME=AUDIRA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=audira
DB_USERNAME=audira
DB_PASSWORD=audira

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_DISPLAY_TIMEZONE=Asia/Kuala_Lumpur
AUDIRA_TRIAL_DAYS=30

# AI platform (Phase 4). AI is off until a key is set AND a firm admin opts in.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (the API then requires a workspace id)
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_RAG_DRIVER=fulltext
AI_EMBEDDINGS_BASE_URL=https://api.openai.com/v1
AI_EMBEDDINGS_API_KEY=
AI_EMBEDDINGS_MODEL=text-embedding-3-small
AI_EMBEDDINGS_DIMENSIONS=1536
